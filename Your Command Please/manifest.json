{
    "manifest_version": 3,
    "name": "Your Command Please",
    "version": "2.1",
    "description": "Plain text commands to simplify your workflow",
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "tabs",
        "history",
        "downloads",
        "bookmarks",
        "storage",
        "activeTab",
        "management",
        "cookies",
        "scripting",
        "clipboardWrite",
        "browsingData"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png"
        }
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Space",
                "mac": "Command+Shift+Space"
            },
            "description": "Open COMMANDER"
        },
        "mute_tab": { "description": "Mute Tab" },
        "unmute_tab": { "description": "Unmute Tab" },
        "clear_cache": { "description": "Clear Cache" },
        "clear_cookies": { "description": "Clear Cookies" },
        "bookmark": { "description": "Bookmark current tab" },
        "reader_mode": { "description": "Toggle Reader Mode" },
        "dark_mode": { "description": "Toggle Dark Mode" }
    }
}
